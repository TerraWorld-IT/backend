# ===== Database =====
# Shared dev PG. Spring manages the `public` schema via Flyway.
# The `auth` schema is owned by the frontend (better-auth) — Spring does
# not write to it, but V5 does declare a FK from public.users → auth."user".
SPRING_DATASOURCE_URL=jdbc:postgresql://HOST:PORT/TERA_WORLD?currentSchema=public
SPRING_DATASOURCE_USERNAME=USER
SPRING_DATASOURCE_PASSWORD=PASSWORD

# ===== Auth (JWT validation via better-auth JWKS) =====
# Points at the frontend's better-auth JWKS endpoint. Spring fetches RS256
# public keys from here on startup and uses them to verify bearer tokens.
# There is NO shared HS256 secret between backend and frontend — the JWT
# private key lives only in the frontend's auth.jwks table.
AUTH_JWKS_URL=http://localhost:3000/api/auth/jwks

# Must match frontend auth.ts `definePayload` issuer/audience exactly.
# Any mismatch rejects every bearer token at verification time.
AUTH_JWT_ISSUER=terraworld
AUTH_JWT_AUDIENCE=terraworld-api

# Shared token used by better-auth databaseHooks (Nitro side) to call
# internal Spring endpoints (signup → profile bootstrap).
# MUST match frontend INTERNAL_API_TOKEN exactly. Transferred out-of-band,
# NOT committed. Generate with `openssl rand -hex 32`.
INTERNAL_API_TOKEN=replace-with-shared-internal-token-32-chars

# ===== CORS =====
# Comma-separated allow-list. Non-prod may include localhost. The prod
# profile fails startup if this includes localhost or is empty.
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://terraworld.app

# ===== Redis =====
REDIS_HOST=localhost
REDIS_PORT=6379
